{
  "version": 2,
  "buildCommand": "npm run build && node scripts/prepare-vercel-static.mjs",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{apps/api/dist/**,packages/*/dist/**,node_modules/pdfjs-dist/**}"
    }
  }
}
