# =============================================================================
# Secure Document Sanitizer - example environment
# =============================================================================
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
#
# There are deliberately NO third-party API keys here. The core sanitization
# pipeline performs no outbound network calls. See docs/ARCHITECTURE.md.
# =============================================================================

# -----------------------------------------------------------------------------
# API server (apps/api)
# -----------------------------------------------------------------------------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001

# Comma-separated list of browser origins allowed to call the API.
# Keep this as tight as possible; never use "*" for a privacy product.
API_CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Upload limits (defence against oversized files / memory exhaustion)
# -----------------------------------------------------------------------------
# Hard ceiling for a single uploaded file, in bytes. Default 10 MiB.
# Phase 1 buffers uploads in memory, so this also bounds per-request memory.
UPLOAD_MAX_FILE_BYTES=10485760

# Maximum number of files accepted per request. The API accepts exactly one.
UPLOAD_MAX_FILES=1

# Reject archives/documents whose decompressed size exceeds this ratio versus
# their compressed size (zip-bomb / decompression-bomb guard).
UPLOAD_MAX_COMPRESSION_RATIO=120

# -----------------------------------------------------------------------------
# Ephemeral session store
# -----------------------------------------------------------------------------
# How long an in-memory analysis session lives before it is wiped, in seconds.
SESSION_TTL_SECONDS=900

# Maximum number of concurrent in-memory sessions before new uploads are refused.
SESSION_MAX_ENTRIES=50

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW=1 minute

# -----------------------------------------------------------------------------
# Sanitization behaviour
# -----------------------------------------------------------------------------
# When true (default), a sanitized document is only released for download if
# post-generation verification PASSES. Set to false at your own risk.
SANITIZATION_STRICT_VERIFICATION=true

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal
# Document contents and detected values are never logged at any level.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Web client (apps/web) - Vite only exposes VITE_* variables to the browser.
# Never put a secret behind a VITE_ prefix.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3001
