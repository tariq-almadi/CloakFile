{
  "name": "@sds/verification",
  "version": "0.1.0",
  "private": true,
  "description": "Re-extracts generated documents and proves the original sensitive values are gone.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@sds/document-processing": "*",
    "@sds/shared": "*"
  }
}
